{
  "name": "tree-sitter-vbnet",
  "version": "0.1.0",
  "description": "VB.NET grammar for tree-sitter (vendored and repaired in-tree)",
  "license": "MIT",
  "author": {
    "name": "govindbanura (upstream grammar)"
  },
  "main": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "vbnet"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "devDependencies": {
    "tree-sitter-cli": "^0.25.1"
  },
  "peerDependencies": {
    "tree-sitter": "^0.21.1"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground"
  }
}
