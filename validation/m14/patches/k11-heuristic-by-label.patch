+/**
+ * M60 K11: render the heuristic bucket's per-label composition for the lane
+ * summary line. Sorted by count so the dominant label is first, and omitted
+ * entirely when the bucket is empty, so a clean lane's line is unchanged.
+ *
+ * `heuristic=621 [overrides=621]` is the difference between a number a reader can
+ * act on and one they cannot: it says the whole bucket is a single label, which
+ * is exactly what a reader needs in order to know that `unexplained=0` says
+ * nothing at all about that label.
+ */
+function heuristicByLabelStr(by: Record<string, number> | undefined): string {
+  if (!by) return ""
+  const entries = Object.entries(by).filter(([, n]) => n > 0).sort((a, b) => b[1] - a[1])
+  if (entries.length === 0) return ""
+  return " [" + entries.map(([k, n]) => `${k}=${n}`).join(" ") + "]"
+}
