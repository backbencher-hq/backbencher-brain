{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "User",
  "title": "User",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "profile": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 2
        }
      },
      "required": ["displayName"]
    }
  },
  "required": ["id", "email"],
  "$defs": {
    "Address": {
      "type": "object",
      "properties": {
        "city": {
          "type": "string"
        }
      },
      "required": ["city"]
    }
  },
  "address": {
    "$ref": "#/$defs/Address"
  }
}
