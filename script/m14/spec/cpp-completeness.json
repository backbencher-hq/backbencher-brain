  "gap": {
    "_description": "Compiler-extension syntax (GNU asm, MS SEH/declspec, extension_expression) parses but is not semantically modeled; surfaced via design_decision as RULED limitations.",
    "gaps": []
  },
  "design_decision": {
    "decisions": [
      {
        "id": "CPP-D1",
        "node_type": "gnu_asm_expression, gnu_asm_qualifier, gnu_asm_output_operand_list, gnu_asm_output_operand, gnu_asm_input_operand_list, gnu_asm_input_operand, gnu_asm_clobber_list, gnu_asm_goto_list, extension_expression",
        "status": "RULED",
        "question": "GNU inline assembly is parsed but not semantically modeled; extension_expression is treated the same. Surfaced as a limitation rather than guessed."
      },
      {
        "id": "CPP-D2",
        "node_type": "seh_try_statement, seh_except_clause, seh_finally_clause, seh_leave_statement, ms_declspec_modifier, ms_based_modifier, ms_call_modifier, ms_unaligned_ptr_modifier, ms_pointer_modifier, ms_restrict_modifier, ms_signed_ptr_modifier, ms_unsigned_ptr_modifier",
        "status": "RULED",
        "question": "MSVC structured exception handling and declspec/based/call/pointer modifiers parse but carry no cross-symbol semantics for this analyzer."
      },
      {
        "id": "CPP-D3",
        "node_type": "cross-file resolution",
        "status": "RULED",
        "question": "The analyzer contract is per-file; project-level resolution and template instantiation across TUs are separate concerns."
      }
    ]
  }
