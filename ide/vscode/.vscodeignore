# the bundled bb_lsp server, and the honesty documents. Everything else is a
# dev artifact and must stay out.
.vscode/**
src/**
esbuild-extension.mjs
tsconfig.json
node_modules/**
**/*.map
**/*.ts
!dist/**
verification-*.png

# server binary must remain: dist/server/lsp/server.js (audit rule AB3)
