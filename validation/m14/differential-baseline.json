      "perf": {
        "avgMsPerFile": 31.459,
        "unit": "ms per file, PRODUCTION entry (pool-worker parseFile), draw = 60 files",
        "draw": {
          "corpus": "kubernetes",
          "available": 6608,
          "files": 60,
          "stride": 110.1,
          "rule": "the baseline's declared samplePerLang=60 with a deterministic stride over the sorted file list"
        },
        "method": "5 timed repetitions of the same 60-file draw after one warm-up parse; the MEDIAN is recorded",
        "spread": {
          "min": 24.591,
          "max": 65.509,
          "all": [
            33.136,
            65.509,
            24.591,
            30.707,
            31.459
          ]
        },
        "loadContext": {
          "loadAvgAtMeasurement": [
            28.93,
            31.1,
            32.17
          ],
          "baselineRecordedLoadAvg": [
            4.85,
            5.19
          ],
          "caveat": "This number was measured at a load average of ~29 against the ~5 recorded in this file's own loadContext, and the 24.6-65.5 ms spread is that contention, not analyzer variance. It is recorded with the load and the spread rather than as a bare figure because a perf claim whose measurement environment is not stated cannot be compared against a later run, and a 6x-loaded box makes any single number a claim about the box. Re-measure on an idle machine before treating it as a regression threshold."
        }
      },
      "differentialDraw": {
        "corpora": 8,
        "filesPerCorpus": 200,
        "comparedFiles": 1004,
        "truthPaths": 357304,
        "oracle": "PyYAML 6.0.1 compose_all",
        "note": "the floor counts are the 8-corpus deep draw, which is WIDER than this file's declared 60-per-lane draw; a wider draw can only make the floor harder to hold, so the 0/0 is a stronger claim than the canonical draw would give"
      },
      "grammarResidual": {
        "files": 15,
        "cause": "tree-sitter-yaml 0.7.1 cannot lex a multi-line double-quoted scalar. CORRECTED 2026-09-28: it is not that a 58-byte token costs the file its containment — the DOCUMENT ROOT becomes an ERROR node and the parse stops, covering only 27.6-31.1% of the file (root ERROR spans 72,809-110,341 bytes over docker/api/docs/v1.25..v1.38), so 69-72% is never parsed at all.",
        "attribution": "PyYAML parses those same 15 files cleanly, and script/m60/yaml-bucket-audit.ts explains 88,675 lost paths across them with 0 unexplained — a path is explained when its own span is damaged, or an ancestor's is, or its bytes lie beyond the parse's extent."
      },
      "note": "Added 2026-09-27 with the yaml lane (M14 #286). The lane has an INDEPENDENT oracle rather than a hand-authored truth file: PyYAML 6.0.1 compose, sharing no code, algorithm or data model with the tree-sitter side, which is the property the shared F5 sweep requires of a lane's truth source (a truth file written by the same hand as the analyzer is a mirror, not a differential)."
    },
