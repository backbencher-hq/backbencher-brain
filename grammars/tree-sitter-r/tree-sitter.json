{
  "grammars": [
    {
      "name": "r",
      "camelcase": "R",
      "scope": "source.r",
      "path": ".",
      "file-types": ["R", "r"],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^r$"
    }
  ],
  "metadata": {
    "version": "1.1.2",
    "license": "MIT",
    "description": "R grammar for tree-sitter",
    "authors": [{ "name": "R Core / r-lib" }]
  },
  "bindings": { "c": true, "go": true, "node": true }
}
