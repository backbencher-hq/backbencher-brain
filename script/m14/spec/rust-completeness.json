  "design_decision": {
    "decisions": [
      {
        "id": "RUST-D1",
        "node_type": "class hierarchy",
        "status": "RULED",
        "question": "Rust has no class-based inheritance; trait supertraits and trait implementations are the hierarchy.",
        "resolution": "TRAIT SEMANTICS: trait supertrait bounds (trait Foo: Bar + Baz) emit extends; impl<Trait> for Type emits implements from the TYPE to the TRAIT. No overrides edge exists by design (no method shadowing across impls)."
      },
      {
        "id": "RUST-D2",
        "node_type": "macro_rules! bodies",
        "status": "RULED",
        "question": "macro_rules! bodies parse as opaque token trees (token_tree/token_repetition/metavariable); expansion is not performed.",
        "resolution": "DECLARED LIMITATION: macro invocations emit a calls edge to the macro NAME (format! -> format), never expanded bodies; macro_definition emits a Macro symbol. Expansions are out of scope for a static analyzer."
      },
      {
        "id": "RUST-D3",
        "node_type": "grammar-derived declarations",
        "status": "RULED",
        "question": "Rust completeness scope is tied to the pinned tree-sitter-rust grammar.",
        "resolution": "The inventory is exhaustive for the pinned grammar; future grammar drift requires a new inventory review."
      }
    ]
  }
}
