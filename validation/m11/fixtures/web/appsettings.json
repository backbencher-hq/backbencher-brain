{
  "name": "order-api",
  "version": "2.4.1",
  "port": 8080,
  "debug": false,
  "environments": {
    "dev": { "url": "http://localhost:8080", "logLevel": "debug" },
    "prod": { "url": "https://api.example.com", "logLevel": "info" }
  },
  "database": {
    "host": "db.internal",
    "pool": {
      "maxConnections": 20,
      "minConnections": 2
    }
  },
  "features": [
    { "name": "auto-cancel", "enabled": true },
    { "name": "fraud-check", "enabled": false }
  ]
}
