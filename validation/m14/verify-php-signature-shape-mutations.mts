import assert from "node:assert/strict"
import { spawnSync } from "node:child_process"
import { fileURLToPath } from "node:url"
const file = fileURLToPath(new URL("./verify-php-signature-shapes.mts", import.meta.url))
const run = (args: string[]) => spawnSync(process.execPath, [file,...args], {encoding:"utf8",timeout:60_000})
const control = run([])
assert.equal(control.status,0,control.stdout+control.stderr)
const mutant = run(["--mutate"])
assert.equal(mutant.error,undefined)
assert.equal(mutant.signal,null)
assert.equal(mutant.status,1,mutant.stdout+mutant.stderr)
assert.ok(mutant.stdout.includes("APPLIED signature mutation"))
assert.ok(mutant.stderr.includes("AssertionError"))
console.log("Signature control passed; bypassed compatibility decision killed")
const contracts = run(["--mutate-contracts"])
assert.equal(contracts.error, undefined)
assert.equal(contracts.signal, null)
assert.equal(contracts.status, 1, contracts.stdout + contracts.stderr)
assert.ok(contracts.stdout.includes("APPLIED constructor contract mutation"))
assert.ok(contracts.stderr.includes("AssertionError"))
console.log("Discarded ancestor constructor contracts killed")
const variance = run(["--mutate-variance"])
assert.equal(variance.error, undefined)
assert.equal(variance.signal, null)
assert.equal(variance.status, 1, variance.stdout + variance.stderr)
assert.ok(variance.stdout.includes("APPLIED variance mutation"))
assert.ok(variance.stderr.includes("AssertionError"))
console.log("Bypassed type variance killed")
for (const name of ["final", "static", "visibility"]) {
  const result = run([`--mutate-local=${name}`])
  assert.equal(result.error, undefined)
  assert.equal(result.signal, null)
  assert.equal(result.status, 1, result.stdout + result.stderr)
  assert.ok(result.stdout.includes(`APPLIED local mutation: ${name}`))
  assert.ok(result.stderr.includes("AssertionError"))
  console.log(`Bypassed local ${name} guard killed`)
}
