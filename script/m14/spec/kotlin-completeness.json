 "design_decision": {
  "decisions": [
   {
    "id": "S1",
    "node_type": "companion_object",
    "status": "PENDING",
    "question": "companion object {} is anonymous (no name); contents emit with owner = enclosing class (probe-verified). Recommend: declared limitation \u2014 no symbol for the anonymous companion itself."
   },
   {
    "id": "S2",
    "node_type": "getter,setter",
    "status": "PENDING",
    "question": "Property accessors (get()/set()) are not separate symbols. Recommend: internal_silent (accessors are property parts)."
   },
   {
    "id": "S3",
    "node_type": "destructuring_declaration,multi_variable_declaration",
    "status": "PENDING",
    "question": "val (a, b) = pair locals are not symbols. Recommend: internal_silent (no local symbols by design)."
   },
   {
    "id": "S4",
    "node_type": "anonymous_function,annotated_lambda,lambda_parameters",
    "status": "PENDING",
    "question": "Anonymous functions / lambdas are expressions, not declarations. Recommend: internal_silent (calls inside ARE captured \u2014 probe-verified)."
   },
   {
    "id": "S5",
    "node_type": "",
