+++ grammars/tree-sitter-nim/grammar.js	2026-09-27 01:49:48.382924948 -0400
@@ -844,6 +844,7 @@
         $.curly_expression,
         $.generalized_string,
         $.pragma_expression,
+        $.do_pragma_expression,
         $.object_type,
         $.tuple_type,
