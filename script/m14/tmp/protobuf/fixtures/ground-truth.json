    {
      "id": "proto2-group-oneof-extend",
      "note": "proto2: a `group` (which declares BOTH a nested type and a field of the same name, so the two ids are disambiguated with `#property`), a oneof (whose fields stay members of the message while carrying metadata.oneof), reserved NUMBERS and reserved NAMES, an extensions range, and an `extend` block whose field is a member of the EXTENDED type across message boundaries. This is the case the `#property` disambiguator exists for.",
      "src": "syntax = \"proto2\";\npackage q;\nmessage M {\n  optional int32 a = 1;\n  oneof pick {\n    string b = 2;\n  }\n  reserved 5, 7 to 9;\n  reserved \"gone\";\n  extensions 100 to 199;\n  optional group G = 4 {\n    optional int32 x = 2;\n  }\n}\nmessage E {\n  extend M {\n    optional int32 ext = 150;\n  }\n}\n",
