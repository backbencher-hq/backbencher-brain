/**
 * Protobuf CONTRACT BATTERY — the analyzer's facts, checked against a
 * HAND-DERIVED truth, then MUTATED.
 *
 * Two halves, and the second is the one that matters:
 *
 *   EXTRACTION — each fixture's expected symbols, relationships and imports are
 *   written out by hand from the specification, not captured from the analyzer.
 *   A truth file generated by running the analyzer is a snapshot of whatever the
 *   analyzer happens to do, and it would agree with every bug in it.
 *
 *   MUTATION — each expectation is then perturbed one at a time and the battery
 *   must FAIL. A battery that cannot detect a changed expectation detects
 *   nothing, so a mutation that survives is reported as a defect in the battery
 *   rather than a pass. Mutations that are DERIVABLY EQUIVALENT (renaming a
 *   fixture field that the analyzer never reads, say) are reported separately
 *   with the reason, because a surviving mutation there is correct behaviour
 *   and must not be counted as coverage.
 *
 * Usage: tsx contract-battery.mts
 */
import * as fs from "fs"
import * as path from "path"
import { GROUND_TRUTH, OUT, ROOT, WASM } from "../paths.mts"

const wts: any = await import(path.join(ROOT, "node_modules/web-tree-sitter/tree-sitter.js"))
const ParserClass = wts.Parser ?? wts.default ?? wts
const Language = wts.Language ?? wts.default?.Language
await ParserClass.init({ locateFile: () => path.join(ROOT, "node_modules/web-tree-sitter/tree-sitter.wasm") })
const parser = new ParserClass()
parser.setLanguage(await Language.load(fs.readFileSync(WASM)))
const { RealProtobufAnalyzer } = await import(path.join(ROOT, "src/ast/real-protobuf-analyzer.ts"))

const truth = JSON.parse(fs.readFileSync(GROUND_TRUTH, "utf8")) as {
  cases: {
    id: string
    note: string
    src: string
    expect: {
      symbols: { kind: string; name: string; owner?: string; line?: number }[]
      relationships: { source: string; type: string; target: string; role?: string }[]
      imports?: string[]
    }
  }[]
}

const problems: string[] = []
const rows: any[] = []

const idOf = (s: any): string => String(s.metadata?.id ?? (s.ownerName ? `${s.ownerName}.${s.name}` : s.name))

/**
 * The single check. Both the main pass and the mutation pass call THIS, which
 * is the point: the mutation harness previously had its own weaker copy that
 * ignored the metadata discriminator and the symbol line, so it failed to detect
 * four mutations the real check catches. A mutation harness that is not the same
 * predicate as the gate measures nothing.
 */
function checkCase(c: any): string[] {
  const res = run(c.src)
  const errs: string[] = []
  const gotSymbols = res.symbols.map((s: any) => ({
    kind: s.kind, name: s.name, owner: s.ownerName, line: s.range.startLine,
  }))
  const gotRels = res.relationships.map((r: any) => ({
    source: r.source, type: r.type, target: r.target, meta: r.metadata?.member ?? r.metadata?.role,
  }))
  for (const want of c.expect.symbols) {
    const hit = gotSymbols.find((s) => s.kind === want.kind && s.name === want.name && (!want.owner || s.owner === want.owner))
    if (!hit) errs.push(`missing symbol ${want.kind} ${want.name}${want.owner ? ` (owner ${want.owner})` : ""}`)
    else if (want.line !== undefined && hit.line !== want.line)
      errs.push(`${want.kind} ${want.name} on line ${hit.line}, truth says ${want.line}`)
  }
  for (const got of gotSymbols) {
    if (!c.expect.symbols.some((w: any) => w.kind === got.kind && w.name === got.name))
      errs.push(`UNEXPECTED symbol ${got.kind} ${got.name} (${idOf(res.symbols.find((s: any) => s.name === got.name && s.kind === got.kind))})`)
  }
  for (const want of c.expect.relationships) {
    const hit = gotRels.find(
      (r) => r.source === want.source && r.type === want.type && r.target === want.target && (!want.meta || r.meta === want.meta),
    )
    if (!hit) errs.push(`missing relationship ${want.source} -${want.type}-> ${want.target}${want.meta ? ` [${want.meta}]` : ""}`)
  }
  for (const got of gotRels) {
    const known = c.expect.relationships.some(
      (w: any) => w.source === got.source && w.type === got.type && w.target === got.target && (!w.meta || w.meta === got.meta),
    )
    if (!known) errs.push(`UNEXPECTED relationship ${got.source} -${got.type}-> ${got.target}${got.meta ? ` [${got.meta}]` : ""}`)
  }
  const gotImports = (res.imports ?? []).map((i: any) => i.module)
  for (const want of c.expect.imports ?? []) if (!gotImports.includes(want)) errs.push(`missing import ${want}`)
  for (const got of gotImports) if (!(c.expect.imports ?? []).includes(got)) errs.push(`UNEXPECTED import ${got}`)
  return errs
}

function run(src: string) {
  const tree: any = parser.parse(src)
  return new RealProtobufAnalyzer().analyze(tree.rootNode, src, "battery.proto") as any
}

for (const c of truth.cases) {
  const errs = checkCase(c)
  if (errs.length) problems.push(`${c.id}: ${errs.join("; ")}`)
  rows.push({ id: c.id, note: c.note, pass: errs.length === 0, errs })
}

// ---------------------------------------------------------------- mutations
type Mut = { why: string; equivalent?: boolean; apply: (c: any) => any }
const MUTATIONS: Mut[] = [
  {
    why: "drop the first expected symbol",
    apply: (t: any) => {
      const x = JSON.parse(JSON.stringify(t))
      if (x.cases[0].expect.symbols.length) x.cases[0].expect.symbols.shift()
      return x
    },
  },
  {
    why: "change an expected symbol's kind",
    apply: (t: any) => {
      const x = JSON.parse(JSON.stringify(t))
      if (x.cases[0].expect.symbols.length) x.cases[0].expect.symbols[0].kind = "function"
      return x
    },
  },
  {
    why: "rename an expected symbol",
    apply: (t: any) => {
      const x = JSON.parse(JSON.stringify(t))
      if (x.cases[0].expect.symbols.length) x.cases[0].expect.symbols[0].name = "NotTheRealName"
      return x
    },
  },
  {
    why: "change an expected symbol's line",
    apply: (t: any) => {
      const x = JSON.parse(JSON.stringify(t))
      const s = x.cases[0].expect.symbols.find((y: any) => y.line !== undefined)
      if (s) s.line = s.line + 7
      return x
    },
  },
  {
    why: "drop the first expected relationship",
    apply: (t: any) => {
      const x = JSON.parse(JSON.stringify(t))
      if (x.cases[0].expect.relationships.length) x.cases[0].expect.relationships.shift()
      return x
    },
  },
  {
    why: "retarget an expected relationship",
    apply: (t: any) => {
      const x = JSON.parse(JSON.stringify(t))
      if (x.cases[0].expect.relationships.length) x.cases[0].expect.relationships[0].target = "nowhere.NotAType"
      return x
    },
  },
  {
    why: "change an expected relationship's type",
    apply: (t: any) => {
      const x = JSON.parse(JSON.stringify(t))
      if (x.cases[0].expect.relationships.length) x.cases[0].expect.relationships[0].type = "implements"
      return x
    },
  },
  {
    why: "drop an expected import",
    apply: (t: any) => {
      const x = JSON.parse(JSON.stringify(t))
      for (const c of x.cases) if (c.expect.imports?.length) c.expect.imports.shift()
      return x
    },
  },
]

/** Re-run the whole battery against a mutated truth, using the SAME check. */
function battery(t: any): string[] {
  const ps: string[] = []
  for (const c of t.cases) for (const e of checkCase(c)) ps.push(`${c.id}: ${e}`)
  return ps
}

const muts: any[] = []
for (const m of MUTATIONS) {
  const mutated = m.apply(truth)
  const ps = battery(mutated)
  muts.push({ why: m.why, equivalent: !!m.equivalent, caught: ps.length > 0, why_missed: ps.length ? undefined : "the mutated expectation changed nothing the battery reads" })
  if (ps.length === 0 && !m.equivalent) problems.push(`MUTATION SURVIVED: ${m.why}`)
}

const caught = muts.filter((m) => m.caught).length
const out = {
  generatedAt: new Date().toISOString(),
  cases: rows.length,
  symbolsChecked: truth.cases.reduce((a, c) => a + c.expect.symbols.length, 0),
  relationshipsChecked: truth.cases.reduce((a, c) => a + c.expect.relationships.length, 0),
  importsChecked: truth.cases.reduce((a, c) => a + (c.expect.imports?.length ?? 0), 0),
  mutations: { total: muts.length, caught, survived: muts.length - caught, detail: muts },
  rows,
  problems,
  pass: problems.length === 0,
}
fs.mkdirSync(OUT, { recursive: true })
fs.writeFileSync(path.join(OUT, "contract-battery.json"), JSON.stringify(out, null, 2))

console.log(`\n  cases: ${rows.length}   symbols: ${out.symbolsChecked}   relationships: ${out.relationshipsChecked}   imports: ${out.importsChecked}`)
console.log(`  mutations: ${caught}/${muts.length} caught, ${muts.length - caught} survived`)
if (problems.length) {
  console.log(`\n  FAIL (${problems.length}):`)
  for (const p of problems.slice(0, 25)) console.log(`    - ${p}`)
} else {
  console.log(`\n  PASS: the hand-derived truth matches, and every mutation was detected`)
}
console.log(`\n  wrote ${path.join(OUT, "contract-battery.json")}`)
process.exit(problems.length ? 1 : 0)
