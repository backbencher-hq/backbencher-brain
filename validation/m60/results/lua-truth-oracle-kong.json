    {
      "rule": "require/module is `imports`, not `calls`",
      "why": "A policy about the label a require carries. The EDGE still has to be found, so a dropped require still shows as missing."
    },
    {
      "rule": "pcall/xpcall wrapping require is `imports`, and the pcall call itself is not a `calls` edge",
      "why": "The wrapper is transport, not a call target the user asked about. Measured rather than assumed: lua's pcall is a stdlib wrapper, and the analyzer's choice is visible in its own source."
    },
    {
      "rule": "a global function is `global` as its `from`",
      "why": "The scope name for top level. Structural, but the alternative (inventing a file scope) would fabricate a node that does not exist."
    }
