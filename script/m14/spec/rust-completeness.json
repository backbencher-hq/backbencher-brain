  "gap": {
    "_description": "No confirmed rust emission gaps remain after the 2026-08-28 review: union_item and associated_type (previously emitting NOTHING) are now handled and fixture-pinned; differential ripgrep:rust is 0 missing / 0 unexplained at the pinned floor.",
    "gaps": []
