  "design_decision": {
    "decisions": [
      {
        "id": "DARTD1",
        "node_type": "selector",
        "status": "RULED",
        "question": "Dart has no invocation_expression node: calls are selector+argument_part pairs, and constructor invocations are capitalized bare identifiers.",
        "resolution": "A selector with an argument_part is a call; the callee is the leaf identifier of the preceding assignable selector (obj.method -> method). A capitalized identifier directly before argument_part is a constructor invocation (instantiates). Confidence 0.9 calls / 0.95 instantiates."
      },
      {
        "id": "DARTD2",
        "node_type": "local_function_declaration,lambda_expression,function_expression",
        "status": "RULED",
        "question": "Local functions, lambdas, and function expressions are not module-level symbols.",
        "resolution": "NO locals/lambdas as symbols (M12.11 family contract). A local_function_declaration still becomes the call-source context for calls inside it; lambda_expression and function_expression are silent internals."
      },
      {
        "id": "DARTD3",
        "node_type": "constructor_signature",
        "status": "RULED",
        "question": "Dart constructors have no distinct name.",
        "resolution": "Emitted as symbol name 'constructor' with metadata isNamed/namedSegment for Counter.initial() style named constructors; factory constructors carry isFactory."
      },
      {
        "id": "DARTD4",
        "node_type": "mixin_declaration,superclass,mixins",
        "status": "RULED",
        "question": "Dart heritage: extends (single superclass), implements (interfaces), with (mixins).",
        "resolution": "superclass -> extends; interfaces -> implements; mixins (with-clause) -> uses with meta.isMixin. mixin_application/mixin_application_class resolve the applied mixin as uses."
      },
      {
        "id": "DARTD5",
        "node_type": "type_identifier,void_type,nullable_type",
        "status": "RULED",
        "question": "tree-sitter-dart parses builtin types (int, String, double) and generics (List<String>) as type_identifier (+ type_arguments), not dedicated builtin_type/generic_type nodes.",
        "resolution": "All type positions resolve via type_identifier/void_type; generic arguments live in type_arguments and are preserved in the type string."
      }
    ]
  }
