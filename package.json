{
  "name": "backbencher-brain",
  "version": "0.1.0",
  "description": "Universal MCP code intelligence server — index any project with 40+ language analyzers",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bb": "./bin/bb"
  },
  "files": [
    "dist/",
    "wasm/",
    "bin/"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "code-intelligence",
    "ast",
    "tree-sitter",
    "brain",
    "indexing",
    "cross-language",
    "code-analysis",
    "backbencher"
  ],
  "author": "Backbencher",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/backbencher-hq/backbencher-brain"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^11.0.0",
    "web-tree-sitter": "^0.24.0",
    "commander": "^12.0.0",
    "ignore": "^5.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "tsx": "^4.0.0",
    "vitest": "^2.0.0"
  }
}
