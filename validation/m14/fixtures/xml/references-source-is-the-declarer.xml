<?xml version="1.0" encoding="UTF-8"?>
<!-- M60 round 10: the SOURCE of a `references` edge is the entity that DECLARES the
     name being referenced, not the element that happens to carry the attribute.

     Four shapes, in one file, because the rule has three branches and a fix that pins
     only the branch it was written for is a fix that can be half-reverted:

       1. the carrier has NO name of its own -> source is the nearest named ancestor.
          `<xs:element ref="comment"/>` sits in `PurchaseOrderType`'s content model, so
          `PurchaseOrderType` references `comment`. Before the re-base this edge was
          emitted as `xs:element -> comment`, and `xs:element` is the schema vocabulary's
          word for a type CONSTRUCTOR: a name no document declares.

       2. the carrier HAS a name of its own -> source is that declaration, NOT the
          nearest named ancestor. `<xs:element name="shipTo" type="AddressType"/>` is
          `shipTo -> AddressType`, and it must NOT become `OrderType -> AddressType`.
          This is the branch that distinguishes the fix from a blanket "walk up to the
          nearest declaration", which would re-base a real edge onto the wrong
          declarer and look correct on branch 1.

       3. an entity USE in content takes the same rule. `<xsl:if>&gt;</xsl:if>` inside
          `<xsl:template name="row">` is `row -> gt`; the instruction's tag is not an
          entity.

       4. NO named declaration in scope -> the enclosing element is kept. An XSLT
          template dispatched by `match=` has no `name` (XSLT 1.0 §5.4), so nothing
          declares it and the per-file analyzer has no honest alternative to the
          element. This row exists so the fallback is PINNED rather than assumed: a
          later change that drops it turns these into refused edges, and that is a
          real edge loss on the highest-volume type in the lane. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
           targetNamespace="urn:example:orders">

  <xs:complexType name="AddressType">
    <xs:sequence>
      <xs:element name="street" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="shipTo" type="AddressType"/>

  <xs:complexType name="PurchaseOrderType">
    <xs:sequence>
      <!-- branch 1: no name of its own, so the type's content model is the source -->
      <xs:element ref="comment" minOccurs="0"/>
      <xs:element ref="shipTo" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="placed" type="xs:date"/>
  </xs:complexType>

  <xsl:template name="row">
    <xsl:if test="@kind">
      <!-- branch 3: a content-level entity use belongs to the named template -->
      &gt;
    </xsl:if>
  </xsl:template>

  <!-- branch 4: match= carries no name, so nothing above this element declares it -->
  <xsl:template match="/">
    <xsl:if test="@x">&lt;</xsl:if>
  </xsl:template>

</xs:schema>
