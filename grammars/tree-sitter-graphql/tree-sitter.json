{
  "grammars": [
    {
      "name": "graphql",
      "camelcase": "GraphQL",
      "scope": "source.graphql",
      "path": ".",
      "file-types": ["graphql", "graphqls", "gql"],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^(graphql|graphqls|gql)$"
    }
  ],
  "metadata": {
    "version": "0.0.1",
    "license": "MIT",
    "description": "GraphQL grammar for tree-sitter (vendored, patched)",
    "authors": [
      { "name": "Bryan Kegley", "email": "hi@bryankegley.me" }
    ]
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "kotlin": true,
    "zig": true
  }
}
