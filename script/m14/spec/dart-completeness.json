  "gap": {
    "_description": "Dart 3 modern constructs (extension types, records, patterns, switch expressions) are parsed but not yet emitted as symbols; they are tracked as gaps for a future wave. The differential floor and fixtures pin the stable core (classes, mixins, extensions, enums, heritage, calls, instantiates, imports).",
    "gaps": [
