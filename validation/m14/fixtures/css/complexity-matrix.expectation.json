      "name": "div > p",
      "kind": "type"
    },
    {
      "name": "a:hover",
      "kind": "class"
    },
    {
      "name": "a[href]",
      "kind": "class"
    },
    {
      "name": "li:not(.skip)",
      "kind": "class"
    },
    {
      "name": ".a, .b",
      "kind": "class"
    },
    {
      "name": "main > section:where(.wide) ul li",
      "kind": "class"
